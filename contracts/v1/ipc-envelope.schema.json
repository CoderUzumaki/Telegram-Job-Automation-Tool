{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-radar.local/contracts/v1/ipc-envelope.schema.json",
  "title": "Job Radar IPC envelope v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "id", "method", "params"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "request" },
        "id": { "type": "string", "format": "uuid" },
        "method": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "id", "ok"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "response" },
        "id": { "type": "string", "format": "uuid" },
        "ok": { "type": "boolean" },
        "result": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" }
          }
        }
      },
      "oneOf": [
        { "required": ["result"], "properties": { "ok": { "const": true }, "result": {} }, "not": { "required": ["error"] } },
        { "required": ["error"], "properties": { "ok": { "const": false }, "error": { "type": "object" } }, "not": { "required": ["result"] } }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "name", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "event" },
        "name": { "type": "string", "minLength": 1 },
        "seq": { "type": "integer", "minimum": 0 },
        "data": { "type": "object" }
      }
    }
  ]
}
