# Telegram — see docs/env-setup.md for how to get each value
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./data/telegram.session
TELEGRAM_CHANNEL=-1001234567890

# Numeric id (-100...), @username, or group display name
# Run: python scripts/list_dialogs.py

# Database
DATABASE_PATH=./data/job_radar.db

# LLM (OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Dashboard
DASHBOARD_USER=admin
DASHBOARD_PASS=changeme
HOST=127.0.0.1
PORT=8000

# Google Sheets export (optional)
GOOGLE_SHEETS_CREDENTIALS_PATH=./data/google_credentials.json
GOOGLE_SHEETS_TOKEN_PATH=./data/google_token.json
GOOGLE_SHEET_ID=
CSV_EXPORT_PATH=./data/exports
